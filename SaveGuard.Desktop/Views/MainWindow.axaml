<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SaveGuard.Desktop.ViewModels"
        xmlns:views="using:SaveGuard.Desktop.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="SaveGuard.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1200" Height="760"
        MinWidth="760" MinHeight="540"
        Background="{DynamicResource AppBackgroundBrush}"
        Icon="/Assets/save-grave-logo.ico"
        Title="Save Grave">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- Shell: content layer + modal overlay layer -->
    <Panel>
        <DockPanel>
            <!-- App shell header -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1">
                <Grid MaxWidth="1180" HorizontalAlignment="Stretch" Margin="32,16" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="10" ClipToBounds="True">
                            <Image Source="/Assets/save-grave-logo.png" Width="36" Height="36"
                                   Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Spacing="0" VerticalAlignment="Center">
                            <TextBlock Classes="brand" Text="Save Grave" />
                            <TextBlock Classes="meta" Text="Automatic protection for your game saves" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="icon" VerticalAlignment="Center" ToolTip.Tip="Settings"
                            Command="{Binding ShowSettingsCommand}">
                        <PathIcon Width="18" Height="18" Foreground="{DynamicResource SecondaryTextBrush}"
                                  Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.49.49 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.49.49 0 0 0-.48-.41h-3.84a.49.49 0 0 0-.48.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96a.49.49 0 0 0-.59.22L2.74 8.87a.49.49 0 0 0 .12.61l2.03 1.58c-.05.3-.07.62-.07.94 0 .33.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.25.41.48.41h3.84c.24 0 .44-.17.48-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32a.49.49 0 0 0-.12-.61l-2.01-1.58zM12 15.6a3.6 3.6 0 1 1 0-7.2 3.6 3.6 0 0 1 0 7.2z" />
                    </Button>
                </Grid>
            </Border>

            <!-- Centered content area -->
            <Border Padding="32,28">
                <Grid MaxWidth="1180" HorizontalAlignment="Stretch">
                    <ContentControl IsVisible="{Binding IsShowingLibrary}" Content="{Binding}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate DataType="vm:MainViewModel">
                                <views:ProtectedGamesView />
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                    <ContentControl IsVisible="{Binding IsShowingDetails}" Content="{Binding CurrentDetails}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate DataType="vm:GameDetailsViewModel">
                                <views:GameDetailsView />
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Grid>
            </Border>
        </DockPanel>

        <!-- Modal / toast overlay host (populated from code-behind) -->
        <Panel Name="OverlayHost" IsHitTestVisible="False" />
    </Panel>
</Window>
