<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SaveGuard.Desktop.ViewModels"
        xmlns:views="using:SaveGuard.Desktop.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="SaveGuard.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1200" Height="760"
        MinWidth="760" MinHeight="540"
        Background="{DynamicResource AppBackgroundBrush}"
        Icon="/Assets/avalonia-logo.ico"
        Title="GameSaveGuard">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- Shell: content layer + modal overlay layer -->
    <Panel>
        <DockPanel>
            <!-- App shell header -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1">
                <Grid MaxWidth="1180" HorizontalAlignment="Stretch" Margin="32,16">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}">
                            <PathIcon Width="18" Height="18" Foreground="{DynamicResource AccentBrush}"
                                      Data="M12 2 L21 5 V11 C21 16 17 20 12 22 C7 20 3 16 3 11 V5 Z M8.5 12 L11 14.5 L15.5 9.5" />
                        </Border>
                        <StackPanel Spacing="0" VerticalAlignment="Center">
                            <TextBlock Classes="brand" Text="GameSaveGuard" />
                            <TextBlock Classes="meta" Text="Automatic protection for your game saves" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Centered content area -->
            <Border Padding="32,28">
                <Grid MaxWidth="1180" HorizontalAlignment="Stretch">
                    <ContentControl IsVisible="{Binding IsShowingLibrary}" Content="{Binding}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate DataType="vm:MainViewModel">
                                <views:ProtectedGamesView />
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                    <ContentControl IsVisible="{Binding IsShowingDetails}" Content="{Binding CurrentDetails}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate DataType="vm:GameDetailsViewModel">
                                <views:GameDetailsView />
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Grid>
            </Border>
        </DockPanel>

        <!-- Modal / toast overlay host (populated from code-behind) -->
        <Panel Name="OverlayHost" IsHitTestVisible="False" />
    </Panel>
</Window>
