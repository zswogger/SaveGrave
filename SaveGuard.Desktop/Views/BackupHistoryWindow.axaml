<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SaveGuard.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="400"
        x:Class="SaveGuard.Desktop.Views.BackupHistoryWindow"
        x:DataType="vm:BackupHistoryViewModel"
        Width="560" Height="400"
        WindowStartupLocation="CenterOwner"
        Title="Backups">

    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

        <ScrollViewer>
            <StackPanel Spacing="8">
                <TextBlock Text="Backups" FontWeight="SemiBold" />
                <TextBlock Text="No backups yet." Foreground="#777777" IsVisible="{Binding !Snapshots.Count}" />

                <ItemsControl ItemsSource="{Binding Snapshots}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SnapshotItemViewModel">
                            <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="0,8">
                                <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Text="{Binding CreatedAtText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" Margin="12,0" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="Restore"
                                            Command="{Binding $parent[ItemsControl].((vm:BackupHistoryViewModel)DataContext).RestoreCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Spacing="8" Margin="0,12,0,0" IsVisible="{Binding HasSafetySnapshots}">
                    <TextBlock Text="Safety snapshots (taken before a restore)" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding SafetySnapshots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SnapshotItemViewModel">
                                <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0" Text="{Binding CreatedAtText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" Margin="12,0" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Content="Restore"
                                                Command="{Binding $parent[ItemsControl].((vm:BackupHistoryViewModel)DataContext).RestoreCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
