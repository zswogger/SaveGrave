<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaveGuard.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
             x:Class="SaveGuard.Desktop.Views.ProtectedGamesView"
             x:DataType="vm:MainViewModel">

    <Grid RowDefinitions="Auto,*">
        <!-- Page header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,22">
            <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                <TextBlock Classes="h1" Text="Protected Games" />
                <TextBlock Classes="secondary"
                           Text="Your saves are automatically backed up when changes are detected." />
            </StackPanel>
            <Button Grid.Column="1" Classes="primary" VerticalAlignment="Center"
                    Command="{Binding AddGameCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Width="13" Height="13" Foreground="{DynamicResource InkBg}"
                              Data="M7 1 H9 V7 H15 V9 H9 V15 H7 V9 H1 V7 H7 Z" />
                    <TextBlock Text="Add Game" Foreground="{DynamicResource InkBg}" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Empty state -->
        <Border Grid.Row="1" IsVisible="{Binding !HasGames}" Classes="card"
                Padding="40" VerticalAlignment="Center" HorizontalAlignment="Center"
                MaxWidth="440">
            <StackPanel Spacing="14" HorizontalAlignment="Center">
                <Border Width="56" Height="56" CornerRadius="16" HorizontalAlignment="Center"
                        Background="{DynamicResource AccentSoftBrush}">
                    <PathIcon Width="26" Height="26" Foreground="{DynamicResource AccentBrush}"
                              Data="M12 2 L21 5 V11 C21 16 17 20 12 22 C7 20 3 16 3 11 V5 Z M8.5 12 L11 14.5 L15.5 9.5" />
                </Border>
                <TextBlock Classes="h2" Text="Protect your first game" HorizontalAlignment="Center" />
                <TextBlock Classes="secondary" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="340"
                           Text="GameSaveGuard automatically creates recovery points when your save files change." />
                <Button Classes="primary" HorizontalAlignment="Center" Margin="0,4,0,0"
                        Command="{Binding AddGameCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Width="12" Height="12" Foreground="{DynamicResource InkBg}"
                                  Data="M7 1 H9 V7 H15 V9 H9 V15 H7 V9 H1 V7 H7 Z" />
                        <TextBlock Text="Add Game" Foreground="{DynamicResource InkBg}" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Game library -->
        <ScrollViewer Grid.Row="1" IsVisible="{Binding HasGames}" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Games}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GameItemViewModel">
                        <Border Classes="card interactive" Margin="0,0,0,14" Padding="20">
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                <!-- Status dot (color + pulse driven by state) -->
                                <Ellipse Grid.Row="0" Grid.Column="0" Width="10" Height="10"
                                         VerticalAlignment="Center" Margin="0,0,14,0"
                                         Classes.pulse="{Binding IsLive}"
                                         Classes.dotSuccess="{Binding IsProtected}"
                                         Classes.dotAccent="{Binding IsBackingUp}"
                                         Classes.dotWarning="{Binding IsPaused}"
                                         Classes.dotDanger="{Binding IsError}" />

                                <!-- Title + status badge -->
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <TextBlock Classes="cardTitle" Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                    <Border Classes="badge"
                                            Classes.success="{Binding IsProtected}"
                                            Classes.accent="{Binding IsBackingUp}"
                                            Classes.warning="{Binding IsPaused}"
                                            Classes.danger="{Binding IsError}">
                                        <StackPanel>
                                            <Ellipse />
                                            <TextBlock Text="{Binding StatusLabel}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Overflow menu -->
                                <Button Grid.Row="0" Grid.Column="2" Classes="icon overflow" VerticalAlignment="Top">
                                    <PathIcon Width="4" Height="16" Foreground="{DynamicResource SecondaryTextBrush}"
                                              Data="M2 1 A1.4 1.4 0 1 0 2 3.8 A1.4 1.4 0 1 0 2 1 Z M2 6.6 A1.4 1.4 0 1 0 2 9.4 A1.4 1.4 0 1 0 2 6.6 Z M2 12.2 A1.4 1.4 0 1 0 2 15 A1.4 1.4 0 1 0 2 12.2 Z" />
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuItem Header="Open save folder"
                                                      Command="{Binding Owner.OpenSaveFolderCommand}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="Open backup folder"
                                                      Command="{Binding Owner.OpenBackupFolderCommand}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="{Binding PauseResumeLabel}"
                                                      Command="{Binding Owner.TogglePauseCommand}"
                                                      CommandParameter="{Binding}" />
                                            <Separator />
                                            <MenuItem Header="Remove from GameSaveGuard" Classes="danger"
                                                      Command="{Binding Owner.RemoveGameCommand}"
                                                      CommandParameter="{Binding}" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>

                                <!-- Metadata + action row -->
                                <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,18,0,0"
                                      ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Classes="meta" Text="Last backup" />
                                        <TextBlock Text="{Binding LastBackupValue}" />
                                    </StackPanel>

                                    <!-- Centered count breakdown filling the middle of the card. -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="48"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel Spacing="2">
                                            <TextBlock Classes="countValue" Text="{Binding BackupCountValue}" />
                                            <TextBlock Classes="countLabel" Text="Backups" />
                                        </StackPanel>
                                        <StackPanel Spacing="2">
                                            <TextBlock Classes="countValue" Text="{Binding ManualCountValue}" />
                                            <TextBlock Classes="countLabel" Text="Manual" />
                                        </StackPanel>
                                        <StackPanel Spacing="2">
                                            <TextBlock Classes="countValue" Text="{Binding SafetyCountValue}" />
                                            <TextBlock Classes="countLabel" Text="Safety" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Content="View Backups"
                                                Command="{Binding Owner.ViewBackupsCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Classes="primary"
                                                Command="{Binding Owner.TakeSnapshotCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <PathIcon Width="12" Height="12" Foreground="{DynamicResource InkBg}"
                                                          Data="M7 1 H9 V7 H15 V9 H9 V15 H7 V9 H1 V7 H7 Z" />
                                                <TextBlock Text="Take Snapshot" Foreground="{DynamicResource InkBg}" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
