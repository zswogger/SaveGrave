<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaveGuard.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="460"
             x:Class="SaveGuard.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Width="460">

    <Border Classes="dialogSurface" Padding="26,24">
        <StackPanel Spacing="20">
            <StackPanel Spacing="5">
                <TextBlock Classes="h2" Text="Settings" />
                <TextBlock Classes="meta" Text="These preferences apply to Save Grave as a whole." />
            </StackPanel>

            <!-- Launch at startup -->
            <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding StartupSupported}">
                <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,16,0">
                    <TextBlock Text="Launch at startup" FontWeight="SemiBold" />
                    <TextBlock Classes="meta" TextWrapping="Wrap" Text="{Binding StartupHint}" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" VerticalAlignment="Top" IsChecked="{Binding LaunchAtStartup}" />
            </Grid>

            <Border Classes="separator" />

            <!-- Close to tray -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,16,0">
                    <TextBlock Text="Keep running in the tray when closed" FontWeight="SemiBold" />
                    <TextBlock Classes="meta" TextWrapping="Wrap"
                               Text="Closing the window hides it to the system tray and protection keeps running. Turn this off to exit when the window closes." />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" VerticalAlignment="Top" IsChecked="{Binding CloseToTray}" />
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,4,0,0">
                <Button Classes="primary" Content="Done" Click="OnDone" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
